POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_DB=theme1_dev
POSTGRES_PORT=5432
SECRET_KEY_BASE=replace-with-output-from-mix-phx-gen-secret
# JWT signing secret; use a different strong value in every environment.
AUTH_JWT_SECRET=replace-with-a-strong-jwt-secret
# Optional bootstrap values used by mix run priv/repo/seeds.exs.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Production password-reset delivery configuration.
PUBLIC_APP_URL=https://your-time-manager-domain.example
MAILER_FROM=no-reply@your-time-manager-domain.example
SMTP_RELAY=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_SSL=true
